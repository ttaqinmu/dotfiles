// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "terminal": {
    "shell": "system"
  },
  "current_line_highlight": "gutter",
  "cursor_animation": {
    "enabled": true
  },
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot"
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "collaboration_mode": "plan"
      },
      "type": "registry"
    }
  },
  "collaboration_panel": {
    "button": false
  },
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "right"
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5"
    }
  },
  "theme": "One Dark Mod",
  "vim_mode": true,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_weight": 500,
  "buffer_font_features": {
    "liga": true,
    "calt": true,
    "clig": true
  },
  "ui_font_family": "JetBrains Mono",
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "relative_line_numbers": "enabled",
  "cursor_blink": false,
  "languages": {
    // "Rust": {
    //   "format_on_save": "on",
    //   "formatter": {
    //     "external": {
    //       "command": "rustfmt",
    //       "arguments": ["{buffer_path}"]
    //     }
    //   },
    //   "language_servers": ["rust-analyzer"]
    // },
    "Python": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "black",
          "arguments": ["-"]
        }
      },
      "language_servers": ["pyright"]
    },
    "TypeScript": {
      "tab_size": 2,
      "language_servers": ["typescript-language-server", "!vtsls", "..."],
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "TSX": {
      "language_servers": ["typescript-language-server", "!vtsls", "..."],
      "tab_size": 2
    },
    "JavaScript": {
      "tab_size": 2,
      "language_servers": ["typescript-language-server", "!vtsls", "..."],
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "Svelte": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    }
  }
}
